{
  "$schema": "https://opencode.ai/config.json",

  "instructions": [
    "./.opencode/instructions/behavior.md",
    "./.opencode/instructions/ultrathink.md"
  ],

  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "~/.agents/**": "allow",
      "~/.cargo/registry/**": "allow",
      "~/.config/rust-camel/**": "allow",
      "*": "ask"
    },

    "bash": {
      "git push*": "deny",
      "*": "allow"
    }
  },

  "mcp": {
    "context-mode": { "enabled": true },
    "gh_grep": { "enabled": true }
  }
}
