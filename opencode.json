{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "./.opencode/instructions/behavior.md",
    "./.opencode/instructions/ultrathink.md"
  ],
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "~/.agents/**": "allow",
      "~/.cargo/registry/**": "allow",
      "~/.config/rust-camel/**": "allow",
      "/home/shared/rust-camel-worktrees/**": "allow"
    },
    "bash": {
      "*": "allow",
      "git push*": "deny"
    }
  },
  "mcp": {
    "context-mode": {
      "enabled": true
    },
    "gh_grep": {
      "enabled": true
    }
  }
}