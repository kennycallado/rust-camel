<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="urn:oneway:363"
    targetNamespace="urn:oneway:363"
    name="OneWay363">

  <wsdl:types>
    <xsd:schema targetNamespace="urn:oneway:363" elementFormDefault="qualified">
      <xsd:element name="receiveMessage" type="xsd:string"/>
      <xsd:element name="echoRequest" type="xsd:string"/>
      <xsd:element name="echoResponse" type="xsd:string"/>
    </xsd:schema>
  </wsdl:types>

  <wsdl:message name="receiveMessageRequest">
    <wsdl:part name="parameters" element="tns:receiveMessage"/>
  </wsdl:message>
  <wsdl:message name="echoRequestMessage">
    <wsdl:part name="parameters" element="tns:echoRequest"/>
  </wsdl:message>
  <wsdl:message name="echoResponseMessage">
    <wsdl:part name="parameters" element="tns:echoResponse"/>
  </wsdl:message>
  <wsdl:message name="aliasReceiveMessageRequest">
    <wsdl:part name="parameters" element="tns:receiveMessage"/>
  </wsdl:message>

  <wsdl:portType name="MainPortType">
    <wsdl:operation name="ReceiveMessageOp">
      <wsdl:input message="tns:receiveMessageRequest"/>
    </wsdl:operation>
    <wsdl:operation name="EchoOp">
      <wsdl:input message="tns:echoRequestMessage"/>
      <wsdl:output message="tns:echoResponseMessage"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:portType name="AliasPortType">
    <wsdl:operation name="ReceiveMessageOp">
      <wsdl:input message="tns:receiveMessageRequest"/>
    </wsdl:operation>
    <wsdl:operation name="AliasReceiveMessageOp">
      <wsdl:input message="tns:aliasReceiveMessageRequest"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="MainBinding" type="tns:MainPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="ReceiveMessageOp">
      <soap:operation soapAction="urn:receive"/>
      <wsdl:input>
        <soap:body use="literal"/>
      </wsdl:input>
    </wsdl:operation>
    <wsdl:operation name="EchoOp">
      <soap:operation soapAction="urn:echo"/>
      <wsdl:input>
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:binding name="AliasBinding" type="tns:AliasPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="ReceiveMessageOp">
      <soap:operation soapAction="urn:receive"/>
      <wsdl:input>
        <soap:body use="literal"/>
      </wsdl:input>
    </wsdl:operation>
    <wsdl:operation name="AliasReceiveMessageOp">
      <soap:operation soapAction="urn:alias"/>
      <wsdl:input>
        <soap:body use="literal"/>
      </wsdl:input>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="OneWayService">
    <wsdl:port name="MainPort" binding="tns:MainBinding">
      <soap:address location="http://localhost:8080/oneway/main"/>
    </wsdl:port>
  </wsdl:service>

  <wsdl:service name="AliasService">
    <wsdl:port name="AliasPort" binding="tns:AliasBinding">
      <soap:address location="http://localhost:8080/oneway/alias"/>
    </wsdl:port>
  </wsdl:service>

</wsdl:definitions>
