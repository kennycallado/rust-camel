// Baseline for `lint_corpus::corpus_zero_false_positives`.
//
// Format: a RON list of `(file_relative_path, [(code, severity), ...])`
// tuples, where file_relative_path is relative to the workspace root and each
// (code, severity) pair is the stable Display string of a DiagnosticCode +
// the lowercase Severity string. The gate asserts set equality between the
// emitted diagnostics and this baseline (every emitted entry is baselined AND
// every baseline entry is emitted). Multiple diagnostics sharing the same
// (code, severity) in one file collapse to a single entry.
//
// Every entry below is an AGREED real defect or an expected by-design note
// (e.g. an `unverified-scheme` Info for a component intentionally skipped by
// `register_builtin_components_for_lint`). Each carries a `//` justification.
// Suspected false positives are NOT baselined - they are reported and the
// rule is fixed/gated instead. See Task 3.2 of openspec/changes/add-camel-lint.
[
    // R-SCHEMA: remaining Apache-style forms not yet rewritten.
    (
        "examples/custom-component-bundle/routes/echo.yaml",
        [("R-SCHEMA", "error")],
    ),
    (
        "examples/cxf-example/routes/soap-consumer.yaml",
        [
            // rc-m1mx fix: object-form `from` fall-through produced this.
            // Stays after canonical rewrite (cxf:// still lacks required opts).
            ("R-URI-known:missing-required-option", "error"),
        ],
    ),
    (
        "examples/hot-reload/routes/route.yaml",
        [("R-SCHEMA", "error")],
    ),
    (
        "examples/wasm-source-webhook/routes/webhook.yaml",
        [("R-SCHEMA", "error")],
    ),

    (
        "examples/file-pollenrich/routes.yaml",
        [
            ("R-URI-known:missing-required-option", "error"),
            ("R-URI-known:unknown-option", "error"),
        ],
    ),
    (
        "examples/http-static-basic/routes/static.yaml",
        [("R-URI-known:missing-required-option", "error")],
    ),
    (
        "examples/http-static-spa/routes/static.yaml",
        [("R-URI-known:missing-required-option", "error")],
    ),

    // R-URI-known:unknown-option — `showCorrelationId` on `log:` URIs. The
    // log component's `LogConfig` declares showHeaders/showBody/maxChars/
    // logMask/showStreamInfo/groupSize but NOT showCorrelationId, and the
    // runtime `from_uri` does not parse it (silently ignored). Same pattern
    // as the file-pollenrich entry above. Surfaced post-merge (main added
    // these example files after the feature branch diverged).
    (
        "examples/resequencer/routes.yaml",
        [("R-URI-known:unknown-option", "error")],
    ),
    (
        "examples/sampling/routes.yaml",
        [("R-URI-known:unknown-option", "error")],
    ),
    (
        "examples/sort/routes.yaml",
        [("R-URI-known:unknown-option", "error")],
    ),

    // R-URI-known:unverified-scheme Info — by-design. The scheme is not
    // registered by `register_builtin_components_for_lint`, so the catalog
    // cannot verify its options. Expected, not a defect.
    (
        "examples/env-interpolation/routes/routes.yaml",
        [("R-URI-known:unverified-scheme", "info")],
    ),
    (
        "examples/wasm-source-webhook/routes/webhook.yaml",
        [("R-URI-known:unverified-scheme", "info")],
    ),

    // parameters.json (added by add-endpoint-parameters Task 2.3). The
    // `kafka:`/`db:` schemes are not registered by
    // `register_builtin_components_for_lint`, so unverified-scheme Info is
    // by-design, matching the env-interpolation/wasm-webhook precedents.
    (
        "examples/json-dsl/config/parameters.json",
        [("R-URI-known:unverified-scheme", "info")],
    ),

    // R-SECRET: `authPassword` (catalog-secret http option) supplied as a
    // literal via the sibling `parameters:` map instead of the query string.
    // Span slices to the secret value — asserted by `secret_in_parameters_flagged`
    // (crates/camel-lint/src/document.rs) — the merge-gate fixture from Task 3.2.
    (
        "crates/camel-cli/tests/fixtures/lint-corpus/parameters-secret.yaml",
        [("R-SECRET", "warning")],
    ),
]
